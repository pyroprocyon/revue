{
  "name": "revue-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "predev": "node scripts/generate-launcher-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-launcher-icons.mjs",
    "build": "npm run typecheck && vite build && node scripts/precompress.mjs dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.domain.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings . && npm run format:check",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.105.3",
    "lucide-react": "1.60.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "oxlint": "1.92.0",
    "prettier": "3.10.1",
    "rolldown": "1.2.16",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
