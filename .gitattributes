# Keep LF line endings in the repo and in checkouts, whatever the local Git settings.
# The Makefile and the shell scripts break with CRLF.
* text=auto eol=lf

# Windows batch files need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
# Precompressed test fixtures
*.br binary
*.gz binary
