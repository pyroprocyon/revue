# Local development settings. `make up` copies this file to .env when .env is missing.
# .env is in .gitignore. Never put real secrets in this example file, because the repo is public.
#
# These database values are for the local Docker database only. Compose publishes its port
# on 127.0.0.1, so nothing outside this machine can reach it. Production uses different values,
# stored in the hosting provider's environment settings.

POSTGRES_DB=revue
POSTGRES_USER=revue
POSTGRES_PASSWORD=local-dev-only

# Host ports. Change them if they are already in use on your machine.
# The database uses 5433, not PostgreSQL's usual 5432, so it doesn't clash with a PostgreSQL
# installed directly on the machine. The backend container still reaches it at db:5432.
DB_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=5173
