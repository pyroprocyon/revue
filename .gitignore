# Local settings and secrets. Only the example file is committed.
.env
.env.*
!.env.example

# Backend build output
backend/target/

# Frontend dependencies and build output
node_modules/
frontend/dist/
frontend/coverage/

# Editors and operating systems
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Python tooling bytecode
__pycache__/

# Sonar analyzer caches (reports are already under backend/target)
.sonar/
.scannerwork/

# Generated browser-test reports
frontend/playwright-report/
frontend/test-results/

# Private engineering context and agent configuration (provision separately).
# Keep these rules in addition to checkout-local .git/info/exclude entries.
.agents/
.claude/
.codex/
AGENTS.md
CLAUDE.md
